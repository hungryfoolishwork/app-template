// Project-identity and policy settings shared by all app targets.
// Everything you'd edit when starting a project or cutting a release lives here.

APP_BUNDLE_IDENTIFIER = work.hungryfoolish.Project
APP_NAME = Project
APP_URL_SCHEME = project
APP_VERSION = 1
APP_MARKETING_VERSION = 1.0

// Identity
DEVELOPMENT_TEAM = 294VZ3T33E
INFOPLIST_KEY_CFBundleDisplayName = $(APP_NAME)
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.utilities

// Platforms
MACOS_DEPLOYMENT_TARGET = 26.0
IOS_DEPLOYMENT_TARGET = 26.0

// Swift
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
